---
const { title="Company Profile Starter", active="beranda" } = Astro.props;
---
<html lang="id"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#071627;color:#0F2340;font-family:Inter,'Segoe UI',system-ui,Arial}
.mono{font-family:ui-monospace,Menlo,Consolas,monospace}
.page{margin:0;background:#F2F6FC;min-height:100vh}
.topbar{background:#0B2545;color:#BFD2EC;font-size:12px;display:flex;justify-content:space-between;padding:9px 32px}
header.site{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:12px 32px;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-bottom:1px solid #D6E2F2}
header.site img{height:36px;background:#0B2545;border-radius:8px;padding:4px 8px}
nav{display:flex;gap:22px;font-size:14px;font-weight:700}nav a{color:#0F2340;text-decoration:none;opacity:.75}nav a.on{opacity:1;color:#1756A6;border-bottom:3px solid #FF8A00;padding-bottom:3px}
.btn{background:#FF8A00;color:#13100A;font-weight:800;padding:11px 20px;border-radius:10px;border:none;text-decoration:none;display:inline-block}
.hero-video{position:relative;height:92vh;min-height:620px;overflow:hidden;background:#071627;color:white}
.hero-video video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,22,39,.92),rgba(7,22,39,.65) 40%,rgba(7,22,39,.15) 70%),linear-gradient(0deg,rgba(7,22,39,.8),transparent 35%)}
.hero-video .top{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;justify-content:space-between;padding:12px 36px;font-size:12px;color:#C9D6E8}
.hero-video .nav2{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:14px 36px}
.hero-video .nav2 img{height:38px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.4);border-radius:10px;padding:4px 8px}
.wa-float{position:fixed;right:22px;bottom:22px;z-index:50;width:58px;height:58px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 30px rgba(0,0,0,.35);transition:transform .15s}
.wa-float:hover{transform:scale(1.08)}
.wa-float svg{width:32px;height:32px;fill:#fff}
.hero-video .links a{color:#fff}
.hero-video .nav2 .links{display:flex;gap:26px;font-size:14px;font-weight:600;align-items:center}
.hero-video .nav2 .links a{color:#fff;text-decoration:none;opacity:.85}
.hero-video .nav2 .links a.on{opacity:1;border-bottom:3px solid #FF8A00;padding-bottom:4px}
.hero-content{position:absolute;z-index:4;left:36px;right:36px;bottom:80px;display:grid;grid-template-columns:1.2fr .8fr;gap:28px;align-items:end}
h1{font-size:62px;line-height:.95;letter-spacing:-.04em;margin:16px 0}.hl{background:#FF8A00;color:#13100A;padding:0 10px;display:inline-block;transform:rotate(-1deg)}
.lead{color:#D3DEEF;max-width:54ch;line-height:1.6}
.logo-marquee{background:#fff;border-top:3px solid #FF8A00;padding:14px 0;overflow:hidden}
.logo-track{display:flex;gap:16px;width:max-content;animation:slide 30s linear infinite;align-items:center}
.logo-track img{height:70px;border:1px solid #DCE6F3;border-radius:14px;padding:6px 10px;background:#fff;object-fit:contain}
.brand-pill{display:inline-flex;align-items:center;height:70px;padding:0 28px;border:1px solid #DCE6F3;border-radius:14px;background:#fff;font-weight:800;color:#1756A6;white-space:nowrap}
@keyframes slide{to{transform:translateX(-50%)}}
.sec{padding:52px 36px}.white{background:#fff}.soft{background:#F2F6FC}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:22px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}
.card{border-radius:18px;overflow:hidden;border:1px solid #DCE6F3;background:#fff}.card img{width:100%;height:165px;object-fit:cover;display:block}.card .t{padding:16px}
table{width:100%;border-collapse:collapse;font-size:13.5px;margin-top:10px}th,td{text-align:left;padding:9px 10px;border-top:1px solid #E3EAF5}th{background:#EFF4FB}
footer{background:#081A30;color:#9FB4CE;padding:38px 36px;display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:20px;font-size:14px}
@media(max-width:900px){.hero-content{grid-template-columns:1fr}h1{font-size:40px}nav{display:none}.grid4,.grid3,footer{grid-template-columns:1fr 1fr}.sec{padding:32px 20px}}
</style></head>
<body><div class="page">
<slot name="hero" />
{active !== 'beranda' && (
<header class="site"><a href="/"><img src="/logo.svg" alt="Contoh Niaga" style="height:36px" /></a>
<nav><a href="/" class={active==='beranda'?'on':''}>Beranda</a><a href="/produk" class={active==='produk'?'on':''}>Produk</a><a href="/kegiatan-event" class={active==='kegiatan'?'on':''}>Kegiatan & Event</a><a href="/kontak" class={active==='kontak'?'on':''}>Kontak</a></nav>
<a class="btn" href="/kontak">Minta Penawaran →</a></header>
)}
<slot />
<footer><div><b style="color:#fff">PT Contoh Niaga</b><br/>Jl. Contoh No. 1, Contoh Kota<br/>© 2026</div><div><b style="color:#fff">Layanan</b><br/>Distribusi FMCG<br/>Merchandising</div><div><b style="color:#fff">Operasional</b><br/>Senin–Sabtu 08.00–17.00<br/><br/><a class="btn" href="/kontak">Minta Penawaran →</a></div></footer>
<a class="wa-float" href="https://wa.me/6281234567890?text=Halo%20Contoh%20Niaga,%20saya%20mau%20tanya%20penawaran." target="_blank" rel="noopener" aria-label="Chat WhatsApp"><svg viewBox="0 0 32 32"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 2 6.5L4 29l7.7-2c1.8 1 3.9 1.5 4.3 1.5 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.4 0-2.8-.4-4-1.1l-.3-.2-4.6 1.2 1.2-4.5-.2-.3c-.8-1.2-1.2-2.6-1.2-4.1 0-4.9 4-8.8 8.9-8.8s9.1 4 9.1 8.9-4 8.9-8.9 8.9zm5-6.6c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1l-1 1.2c-.2.2-.4.3-.7.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2-.2-.3 0-.4.1-.6l.5-.6c.1-.2.2-.4.3-.6.1-.2 0-.4 0-.5L13.4 10c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.2-.9.5-.3.3-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.2 2.4 3.6 5.8 5 .8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 2-1 2.4-1.9.3-.9.3-1.6.2-1.9-.1-.2-.3-.3-.6-.4z"/></svg></a>
</div></body></html>
