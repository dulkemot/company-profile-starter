---
import Base from '../layouts/Base.astro';
import { brands, site, base } from '../data/site.js';
---
<Base title={`${site.company} — ${site.tagline}`} active="beranda">
<div class="hero-video" slot="hero">
<video autoplay muted loop playsinline poster={`${base}/img/hero-poster.jpg`}><source src={`${base}/hero.mp4`} type="video/mp4" /></video>
<div class="scrim"></div>
<div class="nav2"><a href={`${base}/`}><img src={`${base}/logo.svg`} alt="Contoh Niaga" /></a><div class="links"><a class="on" href={`${base}/`}>Beranda</a><a href={`${base}/produk`}>Produk</a><a href={`${base}/kegiatan-event`}>Kegiatan & Event</a><a href={`${base}/kontak`}>Kontak</a></div><a class="btn" href={`${base}/kontak`}>Minta Penawaran →</a></div>
<div class="hero-content"><div>
<h1>Barang jalan<br />sebelum <span class="hl">toko buka.</span></h1>
<p class="lead">Contoh: 6.000+ outlet aktif, 25+ sales lapangan, gudang terpusat, 23 armada. Ganti dengan data sendiri di src/data/site.js</p>
<p><a class="btn" href={`${base}/produk`}>Lihat Produk</a> <a class="btn" style="background:#fff" href={`${base}/kegiatan-event`}>Kegiatan Kami</a></p>
</div>
<div class="side-card" style="background:#F8FAFE;border-radius:18px;padding:20px;max-width:380px;justify-self:end;color:#0F2340"><div class="mono" style="font-size:11px;color:#1756A6">{site.company}</div><div>Gudang pusat — Contoh Kota</div><div>Operasional — {site.hours}</div></div>
</div></div>
<div class="logo-marquee"><div class="logo-track">{brands.concat(brands).map((n) => <span class="brand-pill">{n}</span>)}</div></div>
<div class="sec white"><div class="mono" style="color:#1756A6;font-weight:800;font-size:12px">LAYANAN OPERASIONAL</div>
<h2 style="font-size:36px;margin:8px 0">Operasional yang bisa dicek ke gudang.</h2>
<div class="grid4">
<div class="card"><img src={`${base}/img/sales.jpg`} alt="Team Sales" loading="lazy" /><div class="t"><b>Team Sales</b><div>Kunjungan harian + merchandising.</div></div></div>
<div class="card"><img src={`${base}/img/warehouse.jpg`} alt="Gudang" loading="lazy" /><div class="t"><b>Gudang Terpusat</b><div>Bongkar-muat 2 shift.</div></div></div>
<div class="card"><img src={`${base}/img/outlet.jpg`} alt="Outlet" loading="lazy" /><div class="t"><b>Ribuan Outlet</b><div>Warung sampai modern outlet.</div></div></div>
<div class="card"><img src={`${base}/img/armada.jpg`} alt="Armada" loading="lazy" /><div class="t"><b>Armada</b><div>Box, engkel, motor sales.</div></div></div>
</div></div>
</Base>
