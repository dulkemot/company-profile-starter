---
import Base from '../layouts/Base.astro';
import { base } from '../data/site.js';
const events = [
["Gathering Tahunan","Kebersamaan seluruh divisi — dokumentasi gathering.",`${base}/img/event1.jpg`],
["Demo Produk","Kerja sama dengan brand — demo ke masyarakat.",`${base}/img/event2.jpg`],
["Pelatihan Sales","Asah kemampuan, mental, dan kepercayaan diri sales.",`${base}/img/sales.jpg`],
["Operasional Gudang","Bongkar-muat 2 shift setiap hari.",`${base}/img/warehouse.jpg`]];
---
<Base title="Kegiatan & Event — Starter" active="kegiatan">
<div class="topbar"><span>STARTER</span><span>DOKUMENTASI EVENT</span></div>
<div class="sec white"><div class="mono" style="color:#1756A6;font-weight:800">ACARA & KEGIATAN</div>
<h1 style="font-size:48px;margin:8px 0">Kebersamaan dalam mencapai tujuan.</h1>
<div class="grid3">{events.map(([t,d,img]) => (
<div class="card"><img src={img} alt={t} loading="lazy" /><div class="t"><b>{t}</b><p style="color:#5A6E8A;font-size:14px">{d}</p></div></div>))}</div>
</div>
</Base>
